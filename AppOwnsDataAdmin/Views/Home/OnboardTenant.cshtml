@model AppOwnsDataAdmin.Controllers.HomeController.OnboardTenantModel

<h2 id="page-title">Onboard New Tenant</h2>

<form id="new-tenant" method="post" class="form-horizontal">
  <div class="toolbar">
    <button id="create-tenant-button" type="submit" class="btn btn-primary" style="margin: 6px">
      <i class="fa fa-user-plus"></i>
      Create New Customer Tenant
    </button>
  </div>
  <fieldset style="padding: 8px;">
    <div class="form-group row">
      <label for="TenantName" class="col-sm-3 col-form-label">Workspace / Department Name</label>
      <div class="col-sm-9">
        <input class="form-control" id="TenantName" name="TenantName" placeholder="Enter department name (e.g. Sales)" value="@Model.TenantName">
      </div>
    </div>
    <div class="form-group row">
      <label for="WorkspaceId" class="col-sm-3 col-form-label">Microsoft Fabric Workspace ID</label>
      <div class="col-sm-9">
        <input class="form-control" id="WorkspaceId" name="WorkspaceId" placeholder="Enter Fabric Workspace ID GUID" value="@Model.WorkspaceId" required />
      </div>
    </div>
  </fieldset>
</form>

<div class="loading" style="display:none;">
  <div class="loading-image">
    <img src="~/images/loading.gif" />
  </div>
</div>

@section Scripts {
  <script type="text/javascript">
    $(function() {

        $("#new-tenant").submit(function() {
            $("#new-tenant").hide();
            $("#page-title").text("Onboarding New Tenant...");
            $(".loading").show(100);
        });

    });
  </script>
}