@using System.Security.Principal

@if (User.Identity.IsAuthenticated) {
  <div class="jumbotron">
    <h1>Welcome @User.FindFirst("name").Value</h1>
    <p>Now that you have logged into this application, you can now create new customer tenants and manage user permissions.</p>
  </div>
}
else {
  <div class="jumbotron">

    <h1>Mikano Data Operations Control Center</h1>

    <p>
      Welcome to the administrative backend for Mikano International's embedded analytics infrastructure. This console equips the Data Ops team to seamlessly manage multi-tenant environments, automate Power BI workspace provisioning, and oversee secure access controls across our reporting ecosystem.
    </p>

    <p>Authenticate as an administrator via the sign in link to configure department tenants, register service accounts, and monitor system activity.</p>

  </div>
}